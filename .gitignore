# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.eggs/
build/
sdist/

# Virtual environments
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Secrets and local configuration — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# Claude Code's per-machine permission allowlist
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Node / frontend build output
# (frontend/.gitignore also covers these; repeated here so a stray package
#  anywhere in the repo can't slip node_modules or a build into history)
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
.vite/
coverage/

# ---------------------------------------------------------------------------
# Logs and temporary files
# ---------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.bak
*.orig
tmp/

# ---------------------------------------------------------------------------
# Trained-model and training artefacts
# TabPFN fits at runtime from the CSVs in Data/, so no model binaries need to
# be tracked. NOTE: backend/model_metrics.json is deliberately NOT ignored —
# it is generated by scripts/evaluate_models.py but is SERVED by the API at
# runtime (GET /metrics/:mode), so a fresh clone needs it.
# ---------------------------------------------------------------------------
*.joblib
*.pkl
*.h5
*.pt
*.onnx
catboost_info/
mlruns/
wandb/

# ---------------------------------------------------------------------------
# Source photography kept locally, not committed.
# The originals in the project root are large (~7.7 MB total) and are already
# superseded by the resized, web-optimised copies in
# frontend/public/backgrounds/, which ARE tracked. The leading slash anchors
# these rules to the repo root so the served assets are unaffected.
# ---------------------------------------------------------------------------
/*.jpg
/*.jpeg
/*.png
/*.avif
/*.webp
/*.tif
/*.tiff

# ---------------------------------------------------------------------------
# OS-generated
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sw?
*~
*.suo
*.ntvs*
*.njsproj
*.sln
