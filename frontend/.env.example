# Base URL of the deployed FastAPI backend (the Hugging Face Space).
# Copy this file to .env.local for local dev, or set VITE_API_BASE in the
# Vercel dashboard (Settings -> Environment Variables) for production.
#
# Leave it unset locally to fall back to http://localhost:8000.
#
# The Space URL has the form: https://<hf-username>-<space-name>.hf.space
VITE_API_BASE=https://your-hf-username-slope-stability-ai.hf.space
